modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

    [deployment]
    router = "application"
    deploymentTarget = "autoscale"

    [deployment.postBuild]
    args = ["pnpm", "store", "prune"]
    env = { "CI" = "true" }

    [workflows]
runButton = "Project"

    [[workflows.workflow]]
    name = "Project"
    mode = "parallel"
    author = "agent"

    [[workflows.workflow.tasks]]
    task = "workflow.run"
    args = "artifacts/athletik: Football Athletik App"

    [agent]
    stack = "PNPM_WORKSPACE"
    expertMode = true

    [postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

    [nix]
    channel = "stable-25_05"
packages = ["glibcLocales"]

[userenv]

[userenv.shared]

[userenv.development]
APP_BASE_URL = "https://a811f88b-e0f4-4523-9b0a-e5f8d452c15a-00-3desf7hbgs2q.picard.replit.dev/app"

[userenv.production]
APP_BASE_URL = "https://aphsystem.de"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18150
externalPort = 80
    