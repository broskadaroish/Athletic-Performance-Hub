# ============================================================
# Athletik App — Secrets-Vorlage für Produktivbetrieb
# Kopiere diese Datei nach .streamlit/secrets.toml und fülle
# die Werte aus. secrets.toml NICHT in Git einchecken!
# ============================================================

# Absoluter Pfad zur SQLite-Datenbank (optional).
# Standardwert: athletik.db im Arbeitsverzeichnis der App.
# Für persistenten Speicher in der Cloud: absoluten Pfad zu
# einem gemounteten Volume angeben.
# ATHLETIK_DB_PATH = "/data/athletik.db"

# Session-Secret für Streamlit (zufälliger langer String)
# SESSION_SECRET = "bitte-durch-einen-langen-zufaelligen-wert-ersetzen"
