# ============================================================
# Athletik App — Umgebungsvariablen
#
# Für Produktion: Kopiere diese Datei, fülle sie aus und
# lade die Werte als Secrets / Env-Vars in deinen Hosting-Dienst.
# NIEMALS echte Werte in Git einchecken!
# ============================================================

# ── Anwendung ────────────────────────────────────────────────────────────────
APP_ENV=production                          # development | production
PORT=8080                                   # wird von Render/Railway automatisch gesetzt
LOG_LEVEL=WARNING                           # DEBUG | INFO | WARNING | ERROR

# ── Sicherheit ───────────────────────────────────────────────────────────────
# Langen, zufälligen String verwenden:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# ── Datenbank ────────────────────────────────────────────────────────────────
# Option A — SQLite (Standard, kein weiterer Eintrag nötig außer Pfad):
ATHLETIK_DB_PATH=/data/athletik.db

# Option B — PostgreSQL (überschreibt SQLite wenn gesetzt):
# DATABASE_URL=postgresql://user:password@host:5432/athletik

# ── Datenspeicherort ──────────────────────────────────────────────────────────
# Absoluter Pfad zu einem persistenten Volume (Render: /data, Railway: /mnt/data).
# Unterordner uploads/ und logs/ werden automatisch angelegt.
ATHLETIK_DATA_DIR=/data

# ── Upload-Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_LOGO_MB=2
MAX_SPIELERBILD_MB=5
MAX_DOC_MB=20

# ── Reverse Proxy ─────────────────────────────────────────────────────────────
BEHIND_PROXY=1                              # 1 = App läuft hinter nginx / Cloud-Proxy
